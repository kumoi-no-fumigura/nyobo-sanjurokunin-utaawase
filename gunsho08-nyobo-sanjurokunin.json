 "poems": [
  {
   "seq": "1",
   "text": "花の色は移りにけりないたつらに我身よにふる詠めせしまに",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "思ひつゝぬれはや人のみえつらん夢としりせはさめさらましを",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "いとせめて戀しき時はむは玉のよるの衣をかへしてそきる",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "詠れは衣手すゝし久方の天のかはらの秋のはつかせ",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "玉の〓よ絕なはたえねなからへは忍ふる事のよはりもそする",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "山ふかみ春ともみえぬ松の戶にたえ〓〓かゝる雪の玉水",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "としをへて花の鏡となる水は散かゝるをや曇るといふらん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "あひにあひて物思ふ頃の我袖にやとる月さへぬるゝかほなる",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "おもひ川絕すなかるゝ水の淡のうたかた人にあはて消めや",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "うすくこき野への綠のわか草に跡まてみゆる雪のむらきえ",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "心あるをしまのあまの袂哉月やとれとはぬれぬものから",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "聞やいかにうはの空なる風たにもまつに音するならひ有とは",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "鶯の聲なかりせは雪消ぬ山里いかて春をしらまし",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "秋風の吹につけてもとはぬ哉荻のはならは音はしてまし",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "ありしたにうかりし物をあはすしていつくにそふるつらさ成らん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "夜をかさね待かね山の郭公雲ゐのよそに一こゑそきく",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "契りしにあらぬつらさも逢事のなきにはえ社恨みさりけり",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "春の夜の夢はかりなる手枕にかひなくたゝんなこそおしけれ",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "袖にさへ秋の夕はしられけりきえし淺茅か露をかけつゝ",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "なれ行も浮よなれはや須磨の海士のしほやき衣まとを成らん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "ぬる夢にうつゝのうさも忘られて思ひなくさむ程そはかなき",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "梅の花あかぬ色かも昔にておなしかたみの春のよの月",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "露はらふねさめは秋の昔にてみはてぬ夢に殘るおもかけ",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "夢かとよみし面影も契りしも忘れすなからうつゝならねは",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "大かたの秋の空たに悲しきに物思ひそふきのふけふかな",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "逢事をまつに月日はこゆるきの磯に出てや今はうらみむ",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "忘らるゝみをは思はすちかひてし人の命のおしくも有かな",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "雪深き岩のかけ道跡たゆるよしのゝ里も春はきにけり",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "うき人を忍ふへしとはおもひきや我心さへなとかはるらん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "なかからん心もしらす黑かみの亂れてけさは物を社おもへ",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "都人ねてまつらめやほとゝきす今は山へをなきていつなり",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "吹風につけてもとはんさゝかにの通ひし道は空にたゆとも",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "絕ぬるか影たにみえはとふへきをかたみの水はみくさゐに鳬",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "吹拂ふ嵐の後の高れより木の葉くもらて月や出らん",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "忘れしの〓との葉いかに成ぬらんたのめし暮は秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "何となくきけは涙そこほれける苔の袂にかよふ松かせ",
   "kana": "",
   "speaker": "",
   "page": 523,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "時鳥しのふる物をかしは木のもりても聲のきこえぬる哉",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "逢事のこれやかきりのたひならん草の枕も霜かれにけり",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "こよひ君いかなる里の月をみて都にたれをおもひ出らん",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "沖つ風夜寒になきや田子の浦の海士のもしほ火燒まさるらん",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "夏引の手ひきの糸の年をへて絕ぬ思ひにむすほゝれつゝ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "いく夜かは月を哀と詠めきて浪に折しくいせの濵荻",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "神無月有明の空のしくるゝをまた我ならぬ人やみるらん",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "移ろはてしはし信田の杜をみよかへりもそするくすのうら風",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "いかにねてみえしなとらんうたゝねの夢より後は物を社思へ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "よにふるはくるしき物を槇のやにやすくも過る村しくれ哉",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "一夜とてよかれし床の小莚にやかてもちりのつもりぬる哉",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "散かゝる紅葉の色はふかけれとわたれはにこる山川の水",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "櫻色にそめし衣をぬきかへてやま郭公けふよりそまつ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "物思へは澤の螢も我みよりあくかれいつる玉かとそ見る",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "くらきよりくらき道にそ入ぬへき遙にてらせ山のはの月",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "いくめくり過ぬる秋に逢ぬらむかはらぬ月の影をなかめて",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "つらきをも恨みぬ我にならふなよ浮みをしらぬ人も社あれ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "待宵に更行かねの聲きけはあかぬ別の鳥はものかは",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "大井川柚山かせの寒けれはたつ岩浪を雪かとそみる",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "七夕にかしつと思ひし逢事のその夜なき名の立にけるかな",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "浪ことに袖そぬれけるあやめ草心ににたるねを求むとて",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "あふ人にとへと變らぬおなし名のいくかに成ぬむさしのゝ原",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "行末もうきよの中に何をかは昔はとては人にかたらむ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "心していたくななきそきり〓〓すか〓とかましき老のね覺に",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "のは春のけしきに霞めともむすほゝれたる雪の下草",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "めくり逢てみしやそれとも分ぬまに雲かくれにしよはの月哉",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "みし人の煙となりし夕よりなそむつましきしほかまの浦",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "小山田にまかする水の淺み社袖はひつらめ早苗とるとて",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "逢まての命を人にちきらすはうきに堪てもえやは忍はん",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "置露は草葉の上と思ひしを袖さへぬれて秋はきにけリ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "大江山いくのゝ道の遠けれはまたふみもみすあまの橋たて",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "しぬ計歎きにこそは歎きしかいきてあふへきみにしあらねは",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "おもひ出て誰をか人の尋ねましうきに堪たる命ならすは",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "吹かせものとけき花の都鳥治れる代のことやとはまし",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "しらせはやと計物を思ふ社ならはぬ戀のはしめなりけれ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "恨みてもなきてもいかゝ喞たましみし夜の月のつらさならでは",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "いにしへの奈良の都の八重櫻けふ九重に匂ひぬるかな",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "別にしその日計はめくりきて又もかへらぬ人そかなしき",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "はやくみし山ゐの水の薄氷打とけさまはかはらさりけり",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "もらさはや思ふ心をさてのみはえそ山城のゐてのしからみ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "何か厭ふよもなからへしさのみやはうきに堪たる命なるへき",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "今はとてみさらん秋の末まても思へはかなし夜はの月かけ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "たよりあるかせも吹やと松島によせて久しきあまのはしたて",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "忘らるゝ身は〓とはりとしりなから思ひあへぬは涙成けり",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "よしさらはつらきは我に習ひけリ賴めてこぬは誰かをしへし",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "春は猶かすむにつけてふかき夜の哀をみする月の影哉",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "いかてまたあはてやみにし奥山の岩かき〓水かけをたにみん",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "なかき夜のね覺に思ふ程計うきよをいとふこゝろ有せは",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "はるかなるもろこしまても行物は秋のね覺の心んけり",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "有馬山いなのさゝ原かせふけはいてそよ人を忘れやはする",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "うたかひし命計は有なから契りし中の絕ぬへきむな",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "一聲はおもひそあへぬ時鳥たそかれ時の雲のまよひに",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "いかゝ吹身にしむ色のかはろらんたのむる暮の松風の聲",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "我やとは小倉の山し近けれはうきよなしかとなかぬ日そなき",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "曉の露は枕に置けるを草葉の上となにおもひけむ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "獨ぬる人やしるらん秋の夜をなかしと誰かきみにつけゝむ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "忘れしの行すゑまてはかたけれとけふを限りの命ともかな",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "秋のよを〓とそともなく明ぬとは七夕つめや思ひしるらん",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "いつはりとおもはて人も契けむかはるならひのよ社つらけれ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "人にのみつらさはみえて吹風の心にかなふ山さくら哉",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "浦かせに吹あけの濵のはま千鳥浪たちくらし夜はに鳴ん",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "置露もしつこゝろなく秋かせにみたれて咲るまのゝ萩原",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "音にきく高師の濵のあた浪はかけしや袖のぬれも社すれ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "忘られぬ昔の秋を思ひねの夢をはのこせ庭の松かせ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "みをさらぬおなし浮世とおもはすは岩ほの中も尋みてまし",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "おなしよに賴む契りの空しくはうきみにかへてあふ〓ともかな",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "みわたせは浪のしからみかけてけり卯花さける玉川のみつ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "うらみ侘ほさぬ袖たに有物を戀に朽なむ名こそおしけれ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "もろともにいつかとくへき逢事のかた結ひなる夜はの下紐",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "さひしさは眞柴の烟そのまゝに霞をたのむ春の山さと",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "それをたに心のまゝの命とてやすくや戀にみをもかへてむ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "をのか音につらき別の有とたに思ひもしらて鳥やなくらむ",
   "kana": "",
   "speaker": "",
   "page": 524,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
